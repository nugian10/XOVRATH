# XOVRATH v2 (Nomio model) — .env.example
# Salin ke .env dan isi. JANGAN pernah paste private key / seed phrase di chat.
# File .env tidak boleh di-commit ke GitHub.

# Alamat deployer (yang bayar gas). Private key-nya HANYA di .env lokal.
DEPLOYER_PRIVATE_KEY=

# Owner kontrak — DIPAKSA 30 Okt 2026: Binance Agentic Wallet (BUKAN My Wallet).
# Owner yang bisa memanggil setMintActive / setBaseURI / withdraw /
# setAgentIdRegistry — HANYA lewat agen Binance yang ter-pairing dengan
# Agentic Wallet ini. My Wallet TIDAK bisa memanggil fungsi owner.
OWNER_ADDRESS=0x89c37649Ba3BAA9E1ce028612b7DE4e9c3a947B7

# Revenue wallet: Binance Agentic Wallet — penerima hasil withdraw.
# Sama dengan owner (semua peran = Agentic Wallet).
REVENUE_WALLET=0x89c37649Ba3BAA9E1ce028612b7DE4e9c3a947B7

# Agent ID registry — SPACE ID .ai NFT (publik, dipakai Nomio/AnthroBit/Spoxy).
# Diverifikasi on-chain 30 Okt 2026: kontrak ada, Agentic Wallet 0x89c3...
# memegang 1 Agent ID di sini. Jangan ganti kecuali SPACE ID migrasi.
AGENT_ID_REGISTRY=0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F

# Folder metadata di GitHub (penyimpanan GitHub, bukan IPFS).
# HARUS diakhiri '/'. tokenURI = BASE_URI + tokenId + ".json"  (1.json .. 2222.json)
# Contoh setelah repo terisi: https://raw.githubusercontent.com/nugian10/XOVRATH/main/collection/metadata/
BASE_URI=

# RPC + BscScan (opsional; default di hardhat.config.js sudah ada)
BSC_RPC=https://bsc-dataseed.binance.org/
BSCSCAN_API_KEY=
